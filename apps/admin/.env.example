# Public browser-safe Supabase configuration. Never place the service-role key here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Used to construct password-recovery redirects. Do not include a trailing slash.
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
