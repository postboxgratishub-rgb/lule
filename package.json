{
  "name": "100-day-learning-platform",
  "version": "0.1.0",
  "private": true,
  "description": "A Supabase-backed 100-day learning challenge for mobile, web, and administrators.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace @100-days/web",
    "dev:admin": "npm run dev --workspace @100-days/admin",
    "dev:mobile": "npm run start --workspace @100-days/mobile",
    "android": "npm run android --workspace @100-days/mobile",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:smoke": "node scripts/smoke-auth.mjs",
    "check": "npm run typecheck && npm run test && npm run lint",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset"
  },
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10"
  },
  "devDependencies": {
    "@supabase/supabase-js": "2.95.3",
    "decode-uri-component": "0.5.0",
    "es-abstract": "1.24.2",
    "next": "15.5.25",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "uuid": "11.1.1"
  },
  "overrides": {
    "@supabase/supabase-js": "2.95.3",
    "decode-uri-component": "0.5.0",
    "postcss": "8.5.28",
    "uuid": "11.1.1"
  }
}
